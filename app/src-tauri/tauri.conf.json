{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Status Island",
  "version": "0.1.0",
  "identifier": "com.hossain13.statusisland",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Status Island", "width": 460, "height": 520, "visible": false, "transparent": true, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "focusable": false, "shadow": false }]
  },
  "bundle": { "active": false }
}
